{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/unplugin/{vite,rollup,webpack,rspack,esbuild,bun}.ts",
    "bench/*.bench.ts",
    "scripts/*.ts",
    "examples/*.mts"
  ],
  "project": [
    "src/**/*.ts",
    "bench/**/*.ts",
    "scripts/**/*.ts",
    "examples/**/*.mts",
    "*.config.ts"
  ],
  "tags": ["-lintignore"],
  "treatConfigHintsAsErrors": true
}
