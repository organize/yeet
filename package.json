{
  "name": "yeet",
  "version": "0.1.0",
  "description": "Tiny, performant, dependency-free `Either` monad for TypeScript",
  "keywords": [
    "either",
    "generator",
    "performant",
    "type-safe",
    "type-safe-errors"
  ],
  "bugs": {
    "url": "https://github.com/organize/yeet/issues"
  },
  "license": "MIT",
  "author": "organize <adam@evil.community> (https://github.com/organize)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/organize/yeet.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "bench": "vitest bench --run && bun run scripts/bench-to-csv.ts",
    "bench:memory": "bun run scripts/memory-bench.ts",
    "bench:quick": "BENCH_TIME_MS=1000 BENCH_WARMUP_TIME_MS=300 BENCH_WARMUP_ITERATIONS=20 vitest bench --run && bun run scripts/bench-to-csv.ts",
    "build": "tsc",
    "check": "tsc --noEmit",
    "dev": "bun run src/index.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "quality": "oxlint && oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "25.9.0",
    "better-result": "2.9.2",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "oxlint-tsgolint": "0.23.0",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
