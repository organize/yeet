{
  "name": "@big-time/yeet",
  "version": "0.1.40",
  "description": "Tiny, performant, dependency-free `Either` monad for TypeScript",
  "keywords": [
    "either",
    "generator",
    "performant",
    "type-safe",
    "type-safe-errors"
  ],
  "homepage": "https://github.com/organize/yeet#readme",
  "bugs": {
    "url": "https://github.com/organize/yeet/issues"
  },
  "license": "MIT",
  "author": "organize <adam@evil.community> (https://github.com/organize)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/organize/yeet.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./unplugin": {
      "types": "./dist/unplugin.d.mts",
      "import": "./dist/unplugin.mjs",
      "default": "./dist/unplugin.mjs"
    },
    "./unplugin/vite": {
      "types": "./dist/unplugin/vite.d.mts",
      "import": "./dist/unplugin/vite.mjs",
      "default": "./dist/unplugin/vite.mjs"
    },
    "./unplugin/rollup": {
      "types": "./dist/unplugin/rollup.d.mts",
      "import": "./dist/unplugin/rollup.mjs",
      "default": "./dist/unplugin/rollup.mjs"
    },
    "./unplugin/webpack": {
      "types": "./dist/unplugin/webpack.d.mts",
      "import": "./dist/unplugin/webpack.mjs",
      "default": "./dist/unplugin/webpack.mjs"
    },
    "./unplugin/rspack": {
      "types": "./dist/unplugin/rspack.d.mts",
      "import": "./dist/unplugin/rspack.mjs",
      "default": "./dist/unplugin/rspack.mjs"
    },
    "./unplugin/esbuild": {
      "types": "./dist/unplugin/esbuild.d.mts",
      "import": "./dist/unplugin/esbuild.mjs",
      "default": "./dist/unplugin/esbuild.mjs"
    },
    "./unplugin/bun": {
      "types": "./dist/unplugin/bun.d.mts",
      "import": "./dist/unplugin/bun.mjs",
      "default": "./dist/unplugin/bun.mjs"
    }
  },
  "scripts": {
    "bench": "vitest bench --run && bun run scripts/bench-to-csv.ts",
    "bench:memory": "bun run scripts/memory-bench.ts",
    "bench:quick": "BENCH_TIME_MS=1000 BENCH_WARMUP_TIME_MS=300 BENCH_WARMUP_ITERATIONS=20 vitest bench --run && bun run scripts/bench-to-csv.ts",
    "build": "tsdown",
    "check": "tsc --noEmit",
    "dev": "bun run src/index.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepublishOnly": "bun run build",
    "quality": "oxlint && oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@babel/generator": "^7.29.7",
    "@babel/parser": "^7.29.7",
    "@babel/traverse": "^7.29.7",
    "@babel/types": "^7.29.7",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/bun": "1.3.14",
    "@types/node": "25.9.1",
    "better-result": "2.9.2",
    "oxfmt": "0.53.0",
    "oxlint": "1.68.0",
    "oxlint-tsgolint": "0.23.0",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "unplugin": "^3.0.0",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
