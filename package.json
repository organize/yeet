{
  "name": "@big-time/yeet",
  "version": "0.4.2",
  "description": "tiny, performant, dependency-free `Either` monad for TypeScript",
  "keywords": [
    "do-notation",
    "either",
    "error-handling",
    "generator",
    "monad",
    "performant",
    "railway-oriented",
    "result",
    "result-type",
    "type-safe",
    "type-safe-errors"
  ],
  "homepage": "https://github.com/organize/yeet#readme",
  "bugs": {
    "url": "https://github.com/organize/yeet/issues"
  },
  "license": "MIT",
  "author": "organize <adam@evil.community> (https://github.com/organize)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/organize/yeet.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./stream": {
      "types": "./dist/stream.d.mts",
      "import": "./dist/stream.mjs",
      "default": "./dist/stream.mjs"
    },
    "./unplugin": {
      "types": "./dist/unplugin.d.mts",
      "import": "./dist/unplugin.mjs",
      "default": "./dist/unplugin.mjs"
    },
    "./unplugin/vite": {
      "types": "./dist/unplugin/vite.d.mts",
      "import": "./dist/unplugin/vite.mjs",
      "default": "./dist/unplugin/vite.mjs"
    },
    "./unplugin/rollup": {
      "types": "./dist/unplugin/rollup.d.mts",
      "import": "./dist/unplugin/rollup.mjs",
      "default": "./dist/unplugin/rollup.mjs"
    },
    "./unplugin/webpack": {
      "types": "./dist/unplugin/webpack.d.mts",
      "import": "./dist/unplugin/webpack.mjs",
      "default": "./dist/unplugin/webpack.mjs"
    },
    "./unplugin/rspack": {
      "types": "./dist/unplugin/rspack.d.mts",
      "import": "./dist/unplugin/rspack.mjs",
      "default": "./dist/unplugin/rspack.mjs"
    },
    "./unplugin/esbuild": {
      "types": "./dist/unplugin/esbuild.d.mts",
      "import": "./dist/unplugin/esbuild.mjs",
      "default": "./dist/unplugin/esbuild.mjs"
    },
    "./unplugin/bun": {
      "types": "./dist/unplugin/bun.d.mts",
      "import": "./dist/unplugin/bun.mjs",
      "default": "./dist/unplugin/bun.mjs"
    }
  },
  "scripts": {
    "bench": "bun run scripts/bench.ts",
    "bench:bun": "bun run scripts/bench.ts --target bun",
    "bench:memory": "bun run scripts/memory-bench.ts",
    "bench:node": "bun run scripts/bench.ts --target node",
    "bench:quick": "bun run scripts/bench.ts --quick",
    "bench:quick:bun": "bun run scripts/bench.ts --target bun --quick",
    "bench:quick:node": "bun run scripts/bench.ts --target node --quick",
    "build": "tsdown",
    "check": "tsc --noEmit",
    "dev": "bun run src/index.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepublishOnly": "bun run build",
    "quality": "oxlint && oxfmt --check && knip",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@babel/generator": "8.0.0",
    "@babel/parser": "8.0.4",
    "@babel/traverse": "8.0.4",
    "@babel/types": "8.0.4",
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "better-result": "3.0.0",
    "knip": "6.32.1",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "unplugin": "3.3.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
