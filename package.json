{
  "name": "yeet",
  "version": "0.1.0",
  "description": "Generator-based Either monad for TypeScript",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "bench": "vitest bench --run && bun run scripts/bench-to-csv.ts",
    "bench:memory": "bun run scripts/memory-bench.ts",
    "build": "tsc",
    "check": "tsc --noEmit",
    "dev": "bun run src/index.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "^25.8.0",
    "better-result": "2.9.2",
    "oxfmt": "0.50.0",
    "oxlint": "1.65.0",
    "oxlint-tsgolint": "0.22.1",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
